# Copy this file to .env and fill in the values. .env is git-ignored; never commit real keys.

# API keys. Congress.gov and OpenFEC are issued through api.data.gov; the Census key is issued by
# the Census Bureau (https://www.census.gov/data/developers/api-key.html). Read by the ingestion job.
CONGRESS_GOV_API_KEY=
FEC_API_KEY=
CENSUS_API_KEY=

# Optional overrides (defaults shown). CURRENT_CONGRESS must match the dbt var current_congress;
# the FEC cycle follows from it (119th Congress -> 2026).
# CONGRESS_GOV_REQUESTS_PER_HOUR=5000
# FEC_REQUESTS_PER_HOUR=1000
# FEC_REQUESTS_PER_MINUTE=60
# CURRENT_CONGRESS=119
# BILL_INGEST_MODE=full        # or incremental: the whole Congress, only what changed (ADR 0023)
# BILL_REQUEST_BUDGET=9000     # incremental mode: requests one run may spend on queued bills
# CENSUS_GEOGRAPHY_YEAR=2025   # vintage of the cartographic boundary files (119th Congress)
# CENSUS_ACS_YEAR=2024         # last year of the ACS 5-year estimates (2020-2024)

# Local Postgres started by `docker compose up` (host port 5433; see docker-compose.yml). Read by
# the API and by Alembic when run from
# the host. Inside the api container docker-compose.yml overrides this to point at the `db` service.
DATABASE_URL=postgresql+psycopg://term:term@localhost:5433/term_tracker
